# Copy to .env and paste your key. Never commit .env.
# Register at https://physiology.presagetech.com/auth/register

SMARTSPECTRA_API_KEY=

# Leave blank to use the relay Twenty starts on this computer (127.0.0.1).
# For two laptops, run `npm run relay` on a machine both can reach and set:
# TWENTY_RELAY_URL=ws://192.168.1.20:47221
TWENTY_RELAY_URL=

# Set to 1 to force practice signals even if a key is present.
TWENTY_MOCK=
